<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Web Modeler" exporterVersion="5acd1b5" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.10.0">
  <bpmn:process id="AgenticOrchestration" name="Agentic Orchestration" isExecutable="true">
    <bpmn:extensionElements>
      <zeebe:versionTag value="8.8-alpha5" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="StartEvent_1" name="Find order status">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="find-order-status-1q64g3e" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_0nfbgwl</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0nfbgwl" sourceRef="StartEvent_1" targetRef="Activity_1c7hph6" />
    <bpmn:endEvent id="Event_0yvpec5" name="Request resolved">
      <bpmn:incoming>Flow_1oeqlxl</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="Activity_1c7hph6" name="create user prompt">
      <bpmn:extensionElements>
        <zeebe:script expression="={ &#10;  name: string(get or else(name, &#34;&#34;)),&#10;  orderDate: string(get or else(orderDate, &#34;&#34;)),&#10;  customerId: string(get or else(customerId, &#34;&#34;)),&#10;  providedOrderId: string(get or else(providedOrderId, &#34;&#34;)),&#10;  prompt: &#34;I&#39;m &#34;+name+&#34; and I want to get the status of my order. The order date was &#34;+orderDate+ &#34;, my customer id is &#34;+customerId+ &#34;, my orderId is &#39;&#34;+providedOrderId+&#34;&#39;&#34; &#10;}" resultVariable="prompt" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0nfbgwl</bpmn:incoming>
      <bpmn:outgoing>Flow_0cir26w</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:sequenceFlow id="Flow_0cir26w" sourceRef="Activity_1c7hph6" targetRef="orderTools" />
    <bpmn:sequenceFlow id="Flow_1oeqlxl" sourceRef="orderTools" targetRef="Event_0yvpec5" />
    <bpmn:adHocSubProcess id="orderTools" name="Order Tools" zeebe:modelerTemplate="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="eu-central-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="=camunda.secrets.AWS_BEDROCK_ACCESS_KEY_SSH" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="=camunda.secrets.AWS_BEDROCK_SECRET_KEY_SSH" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="eu.anthropic.claude-opus-4-6-v1" target="provider.bedrock.model.model" />
          <zeebe:input source="=true" target="provider.bedrock.model.parameters.promptCaching.enabled" />
          <zeebe:input source="=1000" target="provider.bedrock.model.parameters.maxTokens" />
          <zeebe:input source="=&#34;You are **TaskAgent**, a helpful, generic chat agent that can handle a wide variety of customer requests using your own domain knowledge **and** any tools explicitly provided to you at runtime.&#10;&#10;If tools are provided, you should prefer them instead of guessing an answer. You can call the same tool multiple times by providing different input values. Don&#39;t guess any tools which were not explicitly configured. If no tool matches the request, try to generate an answer. If you&#39;re not able to find a good answer, return with a message stating why you&#39;re not able to.&#10;&#10;Wrap minimal, inspectable reasoning in *exactly* this XML template:&#10;&#10;&#60;thinking&#62;&#10;&#60;context&#62;…briefly state the customer’s need and current state…&#60;/context&#62;&#10;&#60;reflection&#62;…list candidate tools, justify which you will call next and why…&#60;/reflection&#62;&#10;&#60;/thinking&#62;&#10;&#10;Reveal **no** additional private reasoning outside these tags.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=prompt.prompt" target="data.userPrompt.prompt" />
          <zeebe:input target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent:subprocess:2" retries="3" />
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="1" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.ai-agent-subprocess.v2" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult,&#10;  completedAt: now()&#10;}" />
        <zeebe:agentDefinition agentType="aiAgentSubProcess" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0cir26w</bpmn:incoming>
      <bpmn:outgoing>Flow_1oeqlxl</bpmn:outgoing>
      <bpmn:userTask id="ask_support" name="ask support rep">
        <bpmn:documentation>This task assigns an expert which does the work for you if you cannot find anything about the order.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="ask-support-rep-1s5myyr" />
          <zeebe:assignmentDefinition assignee="" />
          <zeebe:ioMapping>
            <zeebe:input source="={&#10;  providedOrderId: fromAi(toolCall.providedOrderId, &#34;the orderId provided by the customer or null if not set&#34;, &#34;string&#34;),&#10;  foundOrderId: fromAi(toolCall.foundOrderId, &#34;the orderId we found in the system or null&#34;, &#34;string&#34;),&#10;  customerId: fromAi(toolCall.customerId, &#34;the customerId provided by the customer&#34;, &#34;string&#34;),&#10;  orderDate: fromAi(toolCall.orderDate, &#34;the orderDate provided by the customer&#34;, &#34;string&#34;),&#10;  message: fromAi(toolCall.message, &#34;a nice short message asking the rep for help finding the order&#34;, &#34;string&#34;)&#10;}" target="orderInfo" />
            <zeebe:output source="={&#10;  foundOrderId: orderId,&#10;  orderStatus: orderStatus,&#10;  comment: comment&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:userTask>
      <bpmn:serviceTask id="search_order" name="search order">
        <bpmn:documentation>This tool can look up order ids by either orderId or customerId or the orderDate.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="search-order" />
          <zeebe:ioMapping>
            <zeebe:input source="={&#10;  orderId: fromAi(toolCall.providedOrderId, &#34;the provided orderId or an empty string&#34;, &#34;string&#34;),&#10;  customerId: fromAi(toolCall.customerId, &#34;the customer Id from the request&#34;, &#34;string&#34;),&#10;  orderDate: fromAi(toolCall.orderDate, &#34;the order date from the request&#34;, &#34;string&#34;)&#10;}&#10;" target="orderInfo" />
            <zeebe:output source="={ foundOrderId: orderId }" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="reply_to_customer" name="reply to customer">
        <bpmn:documentation>This tool sends a message to the customer when the status of the order is clear.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="inform-customer" />
          <zeebe:ioMapping>
            <zeebe:input source="={&#10;  orderStatus: fromAi(toolCall.orderStatus, &#34;the order status of the exisiting order&#34;, &#34;string&#34;),&#10;  message: fromAi(toolCall.message, &#34;a polite message with the result status of the order or that the order could not be found&#34;, &#34;string&#34;)&#10;}" target="statusMessage" />
            <zeebe:output source="={ responseStatus: message }" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="get_order_status" name="get order status">
        <bpmn:documentation>This task can retrieve the order status by orderId. It cannot search for orders.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="order-status" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.foundOrderId, &#34;the order id provided by the customer or the order id that we found in our system&#34;)" target="orderId" />
            <zeebe:output source="={ orderStatus: orderStatus }" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="find_tracking_info" name="get tracking code">
        <bpmn:documentation>This tool can find a tracking code for orders that have already been shipped.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="get-tracking-code" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.foundOrderId, &#34;the orderId of the shipped order&#34;, &#34;string&#34;)" target="orderId" />
            <zeebe:output source="={ &#10;  trackingNumber: trackingNumber,&#10;  provider: provider,&#10;  estimated_arrival: arrivalTime&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="verify_customer" name="verify customer">
        <bpmn:documentation>This tool verifies that a customer exists by customerId and checks whether the given name matches the registered customer. Use it before sharing any order details.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="verify-customer" />
          <zeebe:ioMapping>
            <zeebe:input source="={&#10;  customerId: fromAi(toolCall.customerId, &#34;the customer id provided by the customer&#34;, &#34;string&#34;),&#10;  name: fromAi(toolCall.name, &#34;the name of the customer from the request or an empty string&#34;, &#34;string&#34;)&#10;}" target="customerInfo" />
            <zeebe:output source="={&#10;  customerExists: customerExists,&#10;  customerId: customerId,&#10;  nameMatches: nameMatches,&#10;  tier: tier,&#10;  message: message&#10;}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
    </bpmn:adHocSubProcess>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="AgenticOrchestration">
      <bpmndi:BPMNShape id="_BPMNShape_StartEvent_2" bpmnElement="StartEvent_1">
        <dc:Bounds x="192" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="169" y="143" width="83" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0yvpec5_di" bpmnElement="Event_0yvpec5">
        <dc:Bounds x="982" y="100" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="957" y="143" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_15dwog5_di" bpmnElement="Activity_1c7hph6">
        <dc:Bounds x="280" y="78" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_08epsxa_di" bpmnElement="orderTools" isExpanded="true">
        <dc:Bounds x="430" y="-27" width="440" height="290" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0ot3d7a_di" bpmnElement="ask_support">
        <dc:Bounds x="460" y="123" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0m9i0b1_di" bpmnElement="search_order">
        <dc:Bounds x="460" y="3" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_1rjs12s_di" bpmnElement="reply_to_customer">
        <dc:Bounds x="600" y="3" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_03pfae2_di" bpmnElement="get_order_status">
        <dc:Bounds x="600" y="123" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_112l1ou_di" bpmnElement="find_tracking_info">
        <dc:Bounds x="740" y="3" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_verify_customer_di" bpmnElement="verify_customer">
        <dc:Bounds x="740" y="123" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_0nfbgwl_di" bpmnElement="Flow_0nfbgwl">
        <di:waypoint x="228" y="118" />
        <di:waypoint x="280" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_0cir26w_di" bpmnElement="Flow_0cir26w">
        <di:waypoint x="380" y="118" />
        <di:waypoint x="430" y="118" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_1oeqlxl_di" bpmnElement="Flow_1oeqlxl">
        <di:waypoint x="870" y="118" />
        <di:waypoint x="982" y="118" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
